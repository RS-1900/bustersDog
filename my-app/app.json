{
  "expo": {
    "name": "Buster’s",
    "slug": "busters-dog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/buster.png",
    "scheme": "bustersdog",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/buster.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/buster.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/buster.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/buster.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
