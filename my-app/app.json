{
  "expo": {
    "name": "Buster’s",
    "slug": "busters-dog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/buster.png",
    "scheme": "bustersdog",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/buster.png"
    },
    "android": {
      "package": "com.bustersdog.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/buster.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/buster.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        { "defaultChannel": "orders", "color": "#8B4513" }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/buster.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9b4ec86-ac6d-4a1f-aa1c-23f5c58b1387"
      }
    }
  }
}
