# Optional for local Expo development: by default the app discovers the API
# on the Metro computer, port 5000. Keep phone and computer on the same Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
# Required for a release or an Expo tunnel: your reachable HTTPS API origin.
# EXPO_PUBLIC_API_URL=https://api.example.com
