{
  "openapi": "3.1.0",
  "info": {
    "title": "Buster’s — API de pedidos para la app",
    "version": "1.0.0",
    "description": "Compra anónima sin datos del alumnado. Moneda MXN. Los precios los calcula el servidor; el folio no autoriza consultas."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Desarrollo local; cambiar por el origen del servidor desde un teléfono"
    }
  ],
  "paths": {
    "/api/v1/catalogo": {
      "get": {
        "operationId": "getCatalog",
        "summary": "Consultar productos disponibles con tamaños y opciones",
        "security": [],
        "responses": {
          "200": {
            "description": "Catálogo disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "500": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sesiones": {
      "post": {
        "operationId": "createShoppingSession",
        "summary": "Crear sesión anónima de compra por siete días",
        "security": [],
        "parameters": [
          {
            "name": "X-Cafe-Request",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token secreto emitido una sola vez",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pedidos": {
      "post": {
        "operationId": "createOrder",
        "summary": "Crear un pedido o recuperar un reintento",
        "description": "Misma sesión, Idempotency-Key y cuerpo: mismo pedido. Cambiar el contenido con la misma clave devuelve 409. Las opciones se cobran por unidad. Máximo 3 productos distintos y 3 unidades por producto sumando variantes y opciones (hasta 9 partidas).",
        "security": [
          {
            "shoppingSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Cafe-Request",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pedido existente recuperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "description": "true al recuperar un pedido anterior; false al crear",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              },
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Ruta de consulta del pedido"
              }
            }
          },
          "201": {
            "description": "Pedido creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "description": "true al recuperar un pedido anterior; false al crear",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              },
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Ruta de consulta del pedido"
              }
            }
          },
          "400": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pedidos/{id}": {
      "get": {
        "operationId": "getOwnOrder",
        "summary": "Consultar un pedido de la misma sesión",
        "security": [
          {
            "shoppingSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pedido e importes históricos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Solicitud rechazada; consulta error y details si existen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "shoppingSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token aleatorio de 64 caracteres hexadecimales"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "ORDER_REJECTED confirma que no se creó el pedido por falta de disponibilidad"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "Variant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "presentation_id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "volume_ml": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10000
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "examples": [
              "37.15"
            ]
          },
          "position": {
            "type": "integer"
          },
          "available": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "product_id",
          "presentation_id",
          "label",
          "volume_ml",
          "price",
          "position",
          "available",
          "archived"
        ]
      },
      "Option": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "group_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "examples": [
              "37.15"
            ]
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "group_id",
          "name",
          "price",
          "available"
        ]
      },
      "ModifierGroup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "min_selections": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          },
          "max_selections": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Option"
            }
          }
        },
        "required": [
          "id",
          "name",
          "min_selections",
          "max_selections",
          "options"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "category_id": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "examples": [
              "37.15"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Variant"
            }
          },
          "modifier_groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModifierGroup"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "image",
          "category_id",
          "category",
          "price",
          "available",
          "archived",
          "created_at",
          "variants",
          "modifier_groups"
        ]
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "const": "MXN"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        },
        "required": [
          "currency",
          "products"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Secreto de compra; guardar en almacenamiento seguro y enviar como Bearer."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "token",
          "expires_at"
        ]
      },
      "CreateItem": {
        "type": "object",
        "properties": {
          "variant_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "option_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 12,
            "uniqueItems": true,
            "default": []
          }
        },
        "required": [
          "variant_id",
          "quantity"
        ],
        "additionalProperties": false
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateItem"
            },
            "minItems": 1,
            "maxItems": 9
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "PurchasedOption": {
        "type": "object",
        "properties": {
          "option_id": {
            "type": "string",
            "format": "uuid"
          },
          "group_name": {
            "type": "string"
          },
          "option_name": {
            "type": "string"
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "examples": [
              "37.15"
            ]
          }
        },
        "required": [
          "option_id",
          "group_name",
          "option_name",
          "price"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "variant_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_name": {
            "type": "string"
          },
          "presentation_label": {
            "type": "string"
          },
          "volume_ml": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10000
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "base_price": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "examples": [
              "37.15"
            ]
          },
          "unit_price": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "examples": [
              "37.15"
            ]
          },
          "line_total": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "examples": [
              "37.15"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PurchasedOption"
            }
          }
        },
        "required": [
          "id",
          "variant_id",
          "product_name",
          "presentation_label",
          "volume_ml",
          "quantity",
          "base_price",
          "unit_price",
          "line_total",
          "options"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "folio": {
            "type": "string",
            "pattern": "^B-[0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "preparing",
              "ready",
              "delivered",
              "cancelled"
            ]
          },
          "currency": {
            "type": "string",
            "const": "MXN"
          },
          "total": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "examples": [
              "37.15"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        },
        "required": [
          "id",
          "folio",
          "status",
          "currency",
          "total",
          "created_at",
          "updated_at",
          "items"
        ]
      }
    }
  }
}
